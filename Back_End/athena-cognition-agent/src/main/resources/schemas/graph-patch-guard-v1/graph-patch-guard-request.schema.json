{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/graph-patch-guard-v1/request.schema.json",
  "title": "Graph patch guard request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "nodeVersion", "runId", "idempotencyKey",
    "triggerType", "contextSnapshotId", "graph", "evidence", "scope", "proposal"],
  "properties": {
    "contractVersion": {"const": "cognition-agent-v1"},
    "nodeVersion": {"const": "graph-patch-guard-v1"},
    "runId": {"type": "string", "minLength": 1},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "triggerType": {"type": "string"},
    "contextSnapshotId": {"type": "string", "minLength": 1},
    "graph": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "scope": {"type": "object"},
    "proposal": {"type": "object"}
  }
}
