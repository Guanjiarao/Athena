{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/graph-patch-guard-v1/response.schema.json",
  "title": "Graph patch guard response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "nodeVersion", "nodeId", "runId", "status",
    "proposal", "graphPreview", "schemaResult", "policyResult", "observation", "error"],
  "properties": {
    "contractVersion": {"const": "cognition-agent-v1"},
    "nodeVersion": {"const": "graph-patch-guard-v1"},
    "nodeId": {"const": "GRAPH_PATCH_GUARD"},
    "runId": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["READY_FOR_CONFIRMATION", "BLOCKED",
      "STALE", "REJECTED", "FAILED"]},
    "proposal": {"type": ["object", "null"]},
    "graphPreview": {"type": ["object", "null"]},
    "schemaResult": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
    "policyResult": {"type": ["string", "null"], "enum": ["PASS", "BLOCK", null]},
    "observation": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]}
  }
}
