{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/evidence-canonicalization-v1/request.schema.json",
  "title": "Evidence canonicalization request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "nodeVersion", "runId", "idempotencyKey",
    "triggerType", "contextSnapshotId", "candidates", "existingEvidence"],
  "properties": {
    "contractVersion": {"const": "cognition-agent-v1"},
    "nodeVersion": {"const": "evidence-canonicalization-v1"},
    "runId": {"type": "string"},
    "idempotencyKey": {"type": "string"},
    "triggerType": {"type": "string", "enum": ["CLUE_CREATED", "USER_REQUEST", "ACTION_FEEDBACK", "RETRY"]},
    "contextSnapshotId": {"type": "string"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/candidate"}},
    "existingEvidence": {"type": "array", "items": {"$ref": "#/$defs/canonicalEvidence"}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceType", "sourceId", "intent", "relationType",
        "summary", "occurredAt", "cycleRelation", "severity", "resolved",
        "relatedActionId", "feedbackResult"],
      "properties": {
        "evidenceId": {"type": "string"},
        "sourceType": {"type": "string", "enum": ["ARTICLE_HIGHLIGHT", "BODY_RECORD", "ACTION_FEEDBACK"]},
        "sourceId": {"type": "string"},
        "intent": {"const": "RELATED"},
        "relationType": {"type": ["string", "null"], "enum": ["CURRENT", "PAST", "OBSERVE", null]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "occurredAt": {"type": ["string", "null"]},
        "cycleRelation": {"type": ["string", "null"]},
        "severity": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
        "resolved": {"type": ["boolean", "null"]},
        "relatedActionId": {"type": ["string", "null"]},
        "feedbackResult": {"type": ["string", "null"],
          "enum": ["OCCURRED", "NOT_OCCURRED", "UNCERTAIN", "SKIPPED", null]}
      }
    },
    "canonicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceType", "sourceId", "factLevel", "summary",
        "contentFingerprint", "occurredAt", "cycleRelation", "severity", "resolved",
        "relatedActionId", "feedbackResult"],
      "properties": {
        "evidenceId": {"type": "string"},
        "sourceType": {"type": "string"},
        "sourceId": {"type": "string"},
        "factLevel": {"type": "string"},
        "summary": {"type": "string"},
        "contentFingerprint": {"type": "string"},
        "occurredAt": {"type": ["string", "null"]},
        "cycleRelation": {"type": ["string", "null"]},
        "severity": {"type": ["integer", "null"]},
        "resolved": {"type": ["boolean", "null"]},
        "relatedActionId": {"type": ["string", "null"]},
        "feedbackResult": {"type": ["string", "null"],
          "enum": ["OCCURRED", "NOT_OCCURRED", "UNCERTAIN", "SKIPPED", null]}
      }
    }
  }
}
