{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/next-action-planning-v1/model-context.schema.json",
  "title": "Next action model context",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "topicTitle", "stageUnderstanding", "openQuestions",
    "evidences", "allowedActionTypes"],
  "properties": {
    "route": {"type": "string", "enum": ["CREATE_BRANCH", "UPDATE_EXISTING"]},
    "topicTitle": {"type": "string", "minLength": 1, "maxLength": 80},
    "stageUnderstanding": {"type": "string", "minLength": 1, "maxLength": 800},
    "openQuestions": {"type": "array", "items": {"type": "string", "maxLength": 500}},
    "evidences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "sourceType", "factLevel", "summary"],
        "properties": {
          "evidenceId": {"type": "string"},
          "sourceType": {"type": "string"},
          "factLevel": {"type": "string"},
          "summary": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    },
    "allowedActionTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["RECORD_BODY", "RECORD_MOOD",
        "RECORD_SLEEP", "ANSWER_QUESTION", "CONFIRM_STATUS"]}
    }
  }
}
