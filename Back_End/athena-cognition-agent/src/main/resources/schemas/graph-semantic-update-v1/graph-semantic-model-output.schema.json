{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/graph-semantic-update-v1/graph-semantic-model-output.schema.json",
  "title": "Graph semantic model output",
  "type": "object",
  "additionalProperties": false,
  "required": ["topicTitle", "stageUnderstanding", "stageUnderstandingEvidenceIds",
    "changes", "changeSummary"],
  "properties": {
    "topicTitle": {"type": "string", "minLength": 1, "maxLength": 80},
    "stageUnderstanding": {"type": "string", "minLength": 1, "maxLength": 1000},
    "stageUnderstandingEvidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "changes": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/change"}
    },
    "changeSummary": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeType", "nodeType", "targetNodeId", "content", "evidenceIds"],
      "properties": {
        "changeType": {"type": "string", "enum": ["ADD", "REVISE", "NO_CHANGE"]},
        "nodeType": {
          "type": "string",
          "enum": ["SELF_REPORTED_FACT", "PATTERN_HYPOTHESIS", "OPEN_QUESTION"]
        },
        "targetNodeId": {"type": ["string", "null"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
