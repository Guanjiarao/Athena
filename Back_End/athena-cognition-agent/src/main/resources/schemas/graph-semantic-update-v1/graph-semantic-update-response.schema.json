{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/graph-semantic-update-v1/response.schema.json",
  "title": "Graph semantic update response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "nodeVersion", "nodeId", "runId", "status",
    "draft", "schemaResult", "policyResult", "observation", "error"],
  "properties": {
    "contractVersion": {"const": "cognition-agent-v1"},
    "nodeVersion": {"const": "graph-semantic-update-v1"},
    "nodeId": {"const": "GRAPH_SEMANTIC_UPDATE_GENERATION"},
    "runId": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["SUCCEEDED", "NO_CHANGE", "BLOCKED", "REJECTED", "FAILED"]},
    "draft": {"type": ["object", "null"]},
    "schemaResult": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
    "policyResult": {"type": ["string", "null"], "enum": ["PASS", "BLOCK", null]},
    "observation": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]}
  }
}
