{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.whu.software/schemas/cognition-graph-workflow-v1/response.schema.json",
  "title": "Cognition graph workflow response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workflowVersion", "runId", "status",
    "evidenceResult", "targetResult", "scopeResult", "semanticResult", "actionResult",
    "patchAssemblyResult", "patchGuardResult", "proposal", "graphPreview", "nextNodeId",
    "error", "observation"],
  "properties": {
    "contractVersion": {"const": "cognition-agent-v1"},
    "workflowVersion": {"const": "cognition-graph-workflow-v1"},
    "runId": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["SEMANTIC_DRAFT_READY", "PROPOSAL_READY",
      "NO_CHANGE", "NEEDS_CONFIRMATION", "STALE", "BLOCKED", "REJECTED", "FAILED"]},
    "evidenceResult": {"type": ["object", "null"]},
    "targetResult": {"type": ["object", "null"]},
    "scopeResult": {"type": ["object", "null"]},
    "semanticResult": {"type": ["object", "null"]},
    "actionResult": {"type": ["object", "null"]},
    "patchAssemblyResult": {"type": ["object", "null"]},
    "patchGuardResult": {"type": ["object", "null"]},
    "proposal": {"type": ["object", "null"]},
    "graphPreview": {"type": ["object", "null"]},
    "nextNodeId": {"type": ["string", "null"]},
    "error": {"type": ["object", "null"]},
    "observation": {"type": ["object", "null"]}
  }
}
