<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="athena.ground.biz.domain.mapper.TopicMapper">

    <resultMap id="BaseResultMap" type="athena.ground.biz.domain.dataobject.TopicDO">
        <id column="id" jdbcType="BIGINT" property="id" />
        <result column="topic_code" jdbcType="VARCHAR" property="topicCode" />
        <result column="topic_name" jdbcType="VARCHAR" property="topicName" />
        <result column="parent_id" jdbcType="BIGINT" property="parentId" />
        <result column="topic_type" jdbcType="TINYINT" property="topicType" />
        <result column="status" jdbcType="TINYINT" property="status" />
        <result column="sort" jdbcType="INTEGER" property="sort" />
        <result column="description" jdbcType="VARCHAR" property="description" />
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
    </resultMap>

    <select id="selectActiveByNames" resultMap="BaseResultMap">
        select id, topic_code, topic_name, parent_id, topic_type, status, sort, description, create_time, update_time
        from tb_topic
        where status = 1
        and topic_name in
        <foreach collection="topicNames" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
        order by sort asc, id asc
    </select>

    <select id="selectActiveById" resultMap="BaseResultMap">
        select id, topic_code, topic_name, parent_id, topic_type, status, sort, description, create_time, update_time
        from tb_topic
        where id = #{id}
          and status = 1
        limit 1
    </select>

</mapper>
