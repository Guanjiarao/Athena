<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="athena.ground.biz.domain.mapper.NoteTopicRelationMapper">

    <delete id="deleteByNoteId">
        delete from tb_note_topic_relation
        where note_id = #{noteId}
    </delete>

    <insert id="batchInsert">
        insert into tb_note_topic_relation (note_id, topic_id, weight, source_type)
        values
        <foreach collection="relations" item="item" separator=",">
            (#{item.noteId}, #{item.topicId}, #{item.weight}, #{item.sourceType})
        </foreach>
    </insert>

</mapper>
