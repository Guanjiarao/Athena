{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/cognition/digest-input-v1.json",
  "type": "object",
  "required": ["schemaVersion", "taskId", "requestedByUser", "evidence", "existingTopics"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "taskId": {"type": "integer", "minimum": 1},
    "requestedByUser": {"type": "boolean"},
    "ruleSignal": {"type": ["object", "null"]},
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceId", "kind", "occurredAt", "summary"],
        "properties": {
          "evidenceId": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["RELATED", "QUESTION", "BODY_RECORD", "CYCLE_RECORD", "DEVICE_RECORD"]},
          "occurredAt": {"type": "string", "format": "date-time"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "question": {"type": ["string", "null"], "maxLength": 1000},
          "reviewedSource": {"type": ["boolean", "null"]}
        }
      }
    },
    "existingTopics": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["topicId", "title", "summary"],
        "properties": {
          "topicId": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "maxLength": 120},
          "summary": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
