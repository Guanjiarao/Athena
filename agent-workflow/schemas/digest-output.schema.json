{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/cognition/digest-output-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eligible", "intent", "title", "commonPoint", "possibleLink", "uncertainty", "action", "evidence", "confidence", "requiresProfessionalHelpRule"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eligible": {"type": "boolean"},
    "reasonCode": {"type": ["string", "null"], "maxLength": 64},
    "intent": {"enum": ["OBSERVE_PERSONAL_CHANGE", "UNDERSTAND_QUESTION", "SAVE_KNOWLEDGE", "OUT_OF_SCOPE"]},
    "matchedTopicId": {"type": ["integer", "null"], "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "commonPoint": {"type": "string", "minLength": 1, "maxLength": 500},
    "possibleLink": {"type": "string", "minLength": 1, "maxLength": 1000},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 1000},
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "instruction", "windowDays"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 500},
        "windowDays": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceId", "role"],
        "properties": {
          "evidenceId": {"type": "integer", "minimum": 1},
          "role": {"enum": ["OBSERVATION_CONTEXT", "QUESTION_CONTEXT", "TIMING", "CONFIRMED_RECORD"]}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requiresProfessionalHelpRule": {"const": false}
  }
}
