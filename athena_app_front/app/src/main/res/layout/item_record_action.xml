<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/white"
    android:paddingHorizontal="18dp">

    <ImageView
        android:id="@+id/action_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_health_icon_circle"
        android:contentDescription="图标"
        android:padding="8dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/action_title"
        style="@style/HealthActionTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/action_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/action_extra_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_action_value"
        app:layout_constraintStart_toEndOf="@id/action_title"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_mood_0"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:alpha="0.3"
            android:contentDescription="心情1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_sentiment_1" />

        <ImageView
            android:id="@+id/iv_mood_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:alpha="0.3"
            android:contentDescription="心情2"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_sentiment_2" />

        <ImageView
            android:id="@+id/iv_mood_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:alpha="0.3"
            android:contentDescription="心情3"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_sentiment_3" />

        <ImageView
            android:id="@+id/iv_mood_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:alpha="0.3"
            android:contentDescription="心情4"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_sentiment_4" />

        <ImageView
            android:id="@+id/iv_mood_4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:alpha="0.3"
            android:contentDescription="心情5"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_sentiment_5" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_action_values"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_action_value"
        app:layout_constraintStart_toEndOf="@id/action_title"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/action_values_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_action_value"
        style="@style/HealthActionMetaText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/action_add_btn"
        app:layout_constraintStart_toEndOf="@id/hsv_action_values"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/action_add_btn"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_action_add_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/period_blue_strong"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/action_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F3ECE6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
