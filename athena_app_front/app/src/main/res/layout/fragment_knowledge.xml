<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_light">

    <!-- ═══════════════════════════════════════════════════════
         顶部页眉（固定，不随内容滚动，不随页面切换消失）
         ═══════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/knowledge_header"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="24dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <!-- 左侧发布按钮（科普页用 INVISIBLE 隐藏，保留占位） -->
        <ImageButton
            android:id="@+id/knowledge_btn_create"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="创作"
            android:src="@drawable/ic_add"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 中间 推荐 / 科普 标签（始终居中） -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/knowledge_tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@android:color/transparent"
            app:tabGravity="center"
            app:tabMode="fixed"
            app:tabIndicatorColor="@color/pink_500"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextColor="@color/text_secondary"
            app:tabRippleColor="@color/pink_200"
            app:tabTextAppearance="@style/TabLayoutTextInactive"
            app:tabSelectedTextAppearance="@style/TabLayoutTextActive">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="科普" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 右侧搜索按钮（始终可见） -->
        <ImageButton
            android:id="@+id/knowledge_btn_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="搜索"
            android:src="@drawable/ic_search"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- ═══════════════════════════════════════════════════════
         主体内容区：ViewPager2 承载"推荐"和"科普"两个子页面
         ═══════════════════════════════════════════════════════ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/knowledge_content_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
