<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFAF7" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="返回"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的认知主题" android:textSize="21sp" android:textStyle="bold" android:textColor="#202725"/></LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="56dp" android:background="#FFFFFF" android:fillViewport="false" android:scrollbars="none"><LinearLayout android:id="@+id/layout_topic_tabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"/></HorizontalScrollView>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tv_topic_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="#20352E"/>
        <TextView android:id="@+id/tv_topic_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#E9F0EA" android:padding="8dp" android:textColor="#476058"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="当前理解" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="#414A47"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="可能的联系" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_link" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#FFFFFF" android:lineSpacingExtra="4dp" android:padding="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="判断依据" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_evidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#FFFFFF" android:lineSpacingExtra="4dp" android:padding="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="还不能确定什么" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_uncertainty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F2EEE6" android:padding="16dp" android:lineSpacingExtra="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="相关可信内容" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_trusted_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#E9F0EA" android:lineSpacingExtra="4dp" android:padding="16dp" android:textColor="#385148"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="最近变化与行动反馈" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#FFFFFF" android:lineSpacingExtra="4dp" android:padding="16dp"/><TextView android:id="@+id/tv_topic_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="#5D6562"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="历史版本" android:textStyle="bold"/><TextView android:id="@+id/tv_topic_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#6B706E" android:lineSpacingExtra="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_topic_action" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp" android:text="完成下一步行动"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_pause_topic" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="暂停观察"/>
        <TextView android:id="@+id/btn_archive_topic" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="归档主题" android:textColor="#77716B"/>
    </LinearLayout></ScrollView>
</LinearLayout>
