<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="48dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tv_health_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6D6D68"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="今天的身体"
            android:textColor="#1E2825"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#E9F0EA"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_health_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在读取今天的状态"
                android:textColor="#1E3B32"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_health_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#476058"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_digest_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:textColor="#4A4F4D"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_focus_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="你可以从最想弄清的一件事开始"
            android:textColor="#4A4F4D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F3EEE5"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_focus_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="选择关注方向后，Athena 会给出一项今天能完成的行动。"
                android:textColor="#4C4030"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_recommended_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="推荐理由：帮助你从可信内容开始了解身体"
                android:textColor="#746653"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Athena 正在理解"
            android:textColor="#1E2825"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_primary_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_primary_topic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#28312E"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_next_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F3EEE5"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_next_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#4C4030"
                android:textSize="16sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_record"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="快捷身体记录"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_body_clues"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="我的身体认知"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="身体工具"
            android:textColor="#1E2825"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btn_cycle_tool" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="周期日历" android:textAllCaps="false" />
            <Button android:id="@+id/btn_history_tool" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="历史记录" android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btn_analysis_tool" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="分析报告" android:textAllCaps="false" />
            <Button android:id="@+id/btn_device_tool" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="设备数据" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
