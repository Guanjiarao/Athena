<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/health_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="返回" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="我的身体线索" android:textColor="@color/health_text_primary" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_pending_digests" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="12dp" android:text="待确认草稿" android:textColor="@color/health_period_strong" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <TextView android:id="@+id/tab_pending" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/bg_body_clue_tab_selector"
            android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center"
            android:text="待整理" android:textColor="@color/body_clue_tab_text" android:textSize="13sp" />
        <TextView android:id="@+id/tab_organized" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/bg_body_clue_tab_selector"
            android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center"
            android:text="已整理" android:textColor="@color/body_clue_tab_text" android:textSize="13sp" />
        <TextView android:id="@+id/tab_questions" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/bg_body_clue_tab_selector"
            android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center"
            android:text="我的疑问" android:textColor="@color/body_clue_tab_text" android:textSize="13sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/layout_clue_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" />
    </ScrollView>

    <TextView
        android:id="@+id/btn_load_more_clues"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_body_clue_content_info"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="加载更多"
        android:textColor="#6952C8"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView android:id="@+id/tv_clue_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="16dp" android:textColor="#777777" />

    <TextView
        android:id="@+id/btn_retry_digest"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_body_clue_content_info"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="重新整理"
        android:textColor="#6952C8"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_digest_visible" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_margin="16dp" android:background="@drawable/bg_body_clue_content_info"
        android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center"
        android:text="把当前线索整理成草稿" android:textColor="#6952C8" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
