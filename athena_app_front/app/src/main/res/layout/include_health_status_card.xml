<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_health_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_health_status_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_health_status_kicker"
                style="@style/HealthStatusKickerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="身体状态" />

            <TextView
                android:id="@+id/tv_health_status_badge"
                style="@style/HealthStatusBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_health_status_badge"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="经期模式" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_health_status_title"
            style="@style/HealthStatusTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="周期第 18 天" />

        <TextView
            android:id="@+id/tv_health_status_subtitle"
            style="@style/HealthStatusSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="身体正在进入黄体期" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="18dp">

            <View
                android:id="@+id/view_health_status_rail"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_health_status_rail" />

            <View
                android:id="@+id/view_health_status_marker"
                android:layout_width="54dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical|center_horizontal"
                android:background="@drawable/bg_health_tab_active" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_health_status_hint"
            style="@style/HealthStatusHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="这几天可以多关注睡眠、情绪和腹部不适" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
