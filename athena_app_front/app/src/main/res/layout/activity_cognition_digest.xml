<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/health_page_bg" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="返回" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="整理草稿" android:textColor="@color/health_text_primary" android:textSize="21sp" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/tv_digest_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/health_text_primary" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="判断依据" android:textStyle="bold" />
            <TextView android:id="@+id/tv_digest_evidence" style="@style/Widget.AppCompat.TextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_body_clue_content_info" android:elevation="4dp" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:padding="18dp" android:textColor="#5F5962" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="可能的联系" android:textStyle="bold" />
            <TextView android:id="@+id/tv_digest_link" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_body_clue_content_info" android:elevation="4dp" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:padding="18dp" android:textColor="#5F5962" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="目前还不能确定" android:textStyle="bold" />
            <TextView android:id="@+id/tv_digest_uncertainty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_body_clue_content_info" android:elevation="4dp" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:padding="18dp" android:textColor="#5F5962" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="建议的下一步" android:textStyle="bold" />
            <TextView android:id="@+id/tv_digest_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_body_clue_content_info" android:elevation="4dp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp" android:padding="18dp" android:textColor="#6952C8" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/layout_digest_decisions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/btn_accept_digest" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_body_clue_content_info" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="加入正在观察" android:textColor="#6952C8" android:textSize="14sp" />
        <TextView android:id="@+id/btn_save_knowledge" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_body_clue_content_info" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="只保存为知识" android:textColor="#6952C8" android:textSize="14sp" />
        <TextView android:id="@+id/btn_reject_digest" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_body_clue_tab_idle" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="这不是我想表达的" android:textColor="#77716B" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
