<?xml version="1.0" encoding="utf-8"?>
<!-- 微信撤回消息风格的系统通知气泡，居中、灰色小字 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_system_notice"
    android:layout_width="wrap_content"
