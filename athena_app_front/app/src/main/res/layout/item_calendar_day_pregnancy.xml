<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_root"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/tv_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/health_text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_day_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:textColor="@color/health_text_secondary"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_pregnancy_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="#6E8BB5"
        android:textSize="9sp"
        android:visibility="gone" />

</LinearLayout>
