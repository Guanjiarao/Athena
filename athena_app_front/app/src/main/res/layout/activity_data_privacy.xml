<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFAF7" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical"><ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="返回"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的数据与隐私" android:textColor="#202725" android:textSize="21sp" android:textStyle="bold"/></LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="你决定 Athena 如何使用认知数据" android:textColor="#20352E" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#FFFFFF" android:lineSpacingExtra="5dp" android:padding="18dp" android:text="本机演示模式\n线索、草稿、主题和反馈保存在本机 SharedPreferences，不调用模型。\n\n云端联调模式\n数据发送到登录账号隔离的 Athena 后端，客户端不上传或选择 userId。\n\nAI 边界\nAndroid 不保存模型密钥。文章原文、问题和 Prompt 不应写入日志。广场、浏览、点赞和普通收藏不会进入健康判断。" android:textColor="#434B48" android:textSize="15sp"/>
        <Switch android:id="@+id/switch_cognition_cloud" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="使用云端认知接口" android:textColor="#27322E" android:textSize="16sp"/>
        <Switch android:id="@+id/switch_personalization" android:layout_width="match_parent" android:layout_height="56dp" android:text="根据我主动选择的主题提供个性化内容" android:textColor="#27322E" android:textSize="16sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="演示数据不会用于模型训练。关闭个性化不会影响已有记录和主题。" android:textColor="#756C61" android:textSize="14sp"/>
        <Button android:id="@+id/btn_export_data" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:text="导出本机认知数据" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_clear_data" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="删除本机认知演示数据" android:textAllCaps="false"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#F2EEE6" android:lineSpacingExtra="4dp" android:padding="16dp" android:text="当前删除和导出仅作用于本机 Mock。云端上线前必须由服务端返回明确处理结果，并支持撤回单条线索。" android:textColor="#665D51" android:textSize="13sp"/>
    </LinearLayout></ScrollView>
</LinearLayout>
