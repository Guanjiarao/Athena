<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/health_page_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical"><ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="返回"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的数据与隐私" android:textColor="@color/health_text_primary" android:textSize="21sp" android:textStyle="bold"/></LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="你决定 Athena 如何使用认知数据" android:textColor="@color/health_text_primary" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#FFFFFF" android:lineSpacingExtra="5dp" android:padding="18dp" android:text="账号隔离\n线索、草稿、主题和反馈保存在登录账号的 Athena 服务中，客户端不会上传或选择 userId。\n\n进入认知闭环的内容\n只有你主动标记的文章片段、主动提出的问题、身体记录和行动反馈。\n\n不会自动进入的内容\n广场内容、浏览历史、点赞和普通收藏不会用于形成身体判断。\n\nAI 边界\nAndroid 不保存模型密钥；当前草稿由 fixed-v1 生成器整理，不代表医学诊断。" android:textColor="@color/health_text_primary" android:textSize="15sp"/>
        <Switch android:id="@+id/switch_personalization" android:layout_width="match_parent" android:layout_height="56dp" android:text="根据我主动选择的主题提供个性化内容" android:textColor="@color/health_text_primary" android:textSize="16sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="关闭个性化不会影响已有记录和主题。尚未进入草稿的单条线索可以在保存后立即撤销。" android:textColor="#756C61" android:textSize="14sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#F2EEE6" android:lineSpacingExtra="4dp" android:padding="16dp" android:text="如果线索已经进入整理草稿，为保证证据可追溯，系统会保留原始线索并说明不能撤销。" android:textColor="#665D51" android:textSize="13sp"/>
    </LinearLayout></ScrollView>
</LinearLayout>
