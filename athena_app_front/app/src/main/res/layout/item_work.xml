<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/athena_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 作品缩略图 -->
        <ImageView
            android:id="@+id/iv_work_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:background="@color/athena_surface_sand"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="作品缩略图" />

        <!-- 作品标题 -->
        <TextView
            android:id="@+id/tv_work_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作品标题"
            android:textSize="14sp"
            android:textColor="@color/athena_text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:padding="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

