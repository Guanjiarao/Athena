<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐页内容（作为 KnowledgeFragment 内 ViewPager2 的第 0 个子页面） -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/athena_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 轮播图：ViewPager2 铺满父容器，左右按钮叠在上方 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="20dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/knowledge_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 叠在 ViewPager2 之上（后声明 = 上层），圆形半透明底 + 纤细 chevron -->
            <ImageButton
                android:id="@+id/btn_banner_left"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:background="@drawable/shape_banner_nav_bg"
                android:contentDescription="上一张"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_banner_chevron_left"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btn_banner_right"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/shape_banner_nav_bg"
                android:contentDescription="下一张"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_banner_chevron_right"
                tools:visibility="visible" />

            <!-- 指示器容器 -->
            <LinearLayout
                android:id="@+id/knowledge_banner_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal" />

        </FrameLayout>

        
        <androidx.cardview.widget.CardView
            android:id="@+id/knowledge_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/athena_surface_sage"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- 左侧文本信息 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/knowledge_status_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi~ (用户名)"
                        android:textSize="14sp"
                        android:textColor="@color/athena_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/knowledge_status_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="目前是经期模式，今天是生理期第3天"
                        android:textSize="12sp"
                        android:textColor="@color/athena_text_secondary" />

                </LinearLayout>

                <!-- 右侧查看分析按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/knowledge_btn_analysis"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="查看分析"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:backgroundTint="@color/athena_sage_strong"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 视频推荐列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/knowledge_video_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
