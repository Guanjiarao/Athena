<?xml version="1.0" encoding="utf-8"?>
<!--
    右侧分类卡片 Item
    ┌──────────────────────────────────────────┐
    │  [图片 64dp]  标题（黑色加粗）           │
    │               描述（灰色小字）           │
    └──────────────────────────────────────────┘
    无时间轴竖线/圆点装饰。
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="23dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_body_clue_content_info"
        android:clipToOutline="true"
        android:minHeight="112dp"
        android:padding="12dp">

        <!-- 左侧封面图（正方形，轻微圆角） -->
        <ImageView
            android:id="@+id/iv_category_cover"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_category_cover"
            android:contentDescription="分类封面"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/athena_text_primary"
            android:textSize="17sp"
            app:layout_constraintBottom_toTopOf="@id/tv_category_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_category_cover"
            app:layout_constraintTop_toTopOf="@id/iv_category_cover"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_category_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/athena_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_category_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_category_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_category_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
