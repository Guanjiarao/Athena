<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 隐私联邦加载弹窗：透明窗口，内容自绘遮罩 -->
    <style name="Theme.PrivacyFederatedDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.Athena" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 极简浅色：白底主色 + 深灰强调（避免默认紫/青） -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/text_secondary</item>
        <item name="android:colorAccent">@color/text_secondary</item>
        <item name="colorSecondary">@color/gray</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 状态栏 / 导航栏：浅色背景 + 深色系统图标 -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Athena.NoActionBar" parent="Theme.Athena">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- 登录 / 注册页：与全站一致的浅色系统栏；控件着色在布局中仍可用 auth_primary -->
    <style name="LoginTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/text_secondary</item>
        <item name="android:colorAccent">@color/text_secondary</item>
        <item name="colorControlActivated">@color/text_secondary</item>
        <item name="colorControlHighlight">@color/gray_light</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- OutlinedBox 输入框：聚焦边框粉色，圆角 12dp -->
    <style name="AuthInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/auth_input_stroke_color</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/auth_hint</item>
        <item name="android:textColorHint">@color/auth_hint</item>
    </style>


    <style name="Theme.Athena.Pink" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/pink_500</item>
        <item name="colorPrimaryVariant">@color/pink_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pink_accent</item>
        <item name="colorSecondaryVariant">@color/pink_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.Athena.Pink.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Athena.Pink.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.Athena.Pink.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- TabLayout 文字样式 - 选中状态 -->
    <style name="TabLayoutTextActive" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- TabLayout 文字样式 - 未选中状态 -->
    <style name="TabLayoutTextInactive" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">17sp</item>
    </style>

