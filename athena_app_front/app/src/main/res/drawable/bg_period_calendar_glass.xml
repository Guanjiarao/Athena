<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#DCFFFFFF"
                android:centerColor="#CDEFEAFF"
                android:endColor="#D8FAF7FF" />
            <stroke android:width="1dp" android:color="#EFFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="16dp" android:top="3dp" android:right="16dp" android:bottom="380dp">
        <shape android:shape="rectangle">
            <solid android:color="#72FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
