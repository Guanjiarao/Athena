<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#D9FFFFFF"
                android:centerColor="#CDEFEAFF"
                android:endColor="#D9FFFFFF" />
            <stroke android:width="1dp" android:color="#DFFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="10dp" android:top="3dp" android:right="10dp" android:bottom="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#70FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
