<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFDFC" />
            <stroke android:width="1dp" android:color="#E8E2DF" />
        </shape>
    </item>
    <item android:left="14dp" android:top="13dp" android:right="17dp" android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#18191D" />
        </shape>
    </item>
    <item android:left="29dp" android:top="29dp" android:right="12dp" android:bottom="11dp">
        <rotate android:fromDegrees="-45" android:toDegrees="-45">
            <shape android:shape="rectangle">
                <corners android:radius="1dp" />
                <solid android:color="#18191D" />
            </shape>
        </rotate>
    </item>
</layer-list>
