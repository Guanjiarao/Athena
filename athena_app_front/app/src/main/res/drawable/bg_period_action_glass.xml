<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFF1DA"
                android:centerColor="#FFE7C4"
                android:endColor="#FFF8EE" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#BFFFFFFF"
                android:endColor="#0AFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
