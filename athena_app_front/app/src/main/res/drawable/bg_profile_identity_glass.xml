<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 淡紫到淡青的玻璃主体 -->
    <item>

        <shape android:shape="rectangle">

            <corners android:radius="26dp" />

            <gradient
                android:angle="0"
                android:startColor="#F2E9E6F5"
                android:endColor="#F2E4F1F2" />

            <stroke
                android:width="1dp"
                android:color="#F5FFFFFF" />

        </shape>

    </item>


    <!-- 顶部很薄的玻璃高光 -->
    <item
        android:left="22dp"
        android:top="4dp"
        android:right="22dp"
        android:bottom="132dp">

        <shape android:shape="rectangle">

            <corners android:radius="8dp" />

            <gradient
                android:angle="270"
                android:startColor="#A8FFFFFF"
                android:endColor="#0AFFFFFF" />

        </shape>

    </item>

</layer-list>