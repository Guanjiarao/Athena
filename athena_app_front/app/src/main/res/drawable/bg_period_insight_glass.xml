<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#E7F2FF"
                android:centerColor="#DCEBFF"
                android:endColor="#F4F8FF" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#AFFFFFFF"
                android:endColor="#08FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
