<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="37dp" />
            <gradient
                android:angle="0"
                android:centerColor="#72E9DFFF"
                android:endColor="#78FFD8E9"
                android:startColor="#78D8D0FF" />
            <stroke
                android:width="1dp"
                android:color="#C7FFFFFF" />
        </shape>
    </item>

    <item
        android:left="12dp"
        android:top="5dp"
        android:right="12dp"
        android:bottom="53dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:endColor="#08FFFFFF"
                android:startColor="#4FFFFFFF" />
        </shape>
    </item>
</layer-list>
