<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#DCCFFF"
                android:centerColor="#E7D5F7"
                android:endColor="#FFDCEB" />
            <stroke android:width="1dp" android:color="#E8FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="8dp" android:top="2dp" android:right="8dp" android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#6AFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
